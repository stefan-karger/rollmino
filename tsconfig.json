{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["engine/**/*.ts", "src/**/*.ts", "e2e/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "original-handoff", "research-archive"]
}
